import React, { useState } from 'react';
import { Text, TextInput, Button, View } from 'react-native';


export default function App() {
  // Variáveis com valores iniciais
  const [saldo, setSaldo] = useState(1000.00); // Saldo inicial de R$ 500
  const [valorSaque, setValorSaque] = useState('');
  const [status, setStatus] = useState('');
  const [fim, setFim] = useState('');


  const realizarSaque = () => {
    try {
      const saque = parseFloat(valorSaque);


      // Validações usando Condição e Operações Matemáticas
      if (isNaN(saque) || saque <= 0) {
        throw 'Digite um valor de saque válido!';
      }
      if (saque > saldo) {
        throw 'Voce e Pobre!! coloque um valor que tenha na conta.';
      }


      // Operação matemática: Subtração do saldo
      const novoSaldo = saldo - saque;
      setSaldo(novoSaldo);
      setStatus(` Saque de R$ ${saque.toFixed(2)} realizado com sucesso!`);
     
    } catch (erro) {
      // Captura as mensagens do throw
      setStatus(` Erro: ${erro}`);
    } finally {
      // Executa sempre ao terminar
      setFim('Operação bancária finalizada.');
    }
  };


  return (
    <View style={{ flex: 1, justifyContent: 'center', padding: 20 }}>
      <Text style={{ fontSize: 20, fontWeight: 'bold' }}>Caixa Eletrônico</Text>
      <Text style={{ fontSize: 16, marginVertical: 10, color: '#690B7D' }}>
        Saldo Atual: R$ {saldo.toFixed(2)}
      </Text>
     
      <TextInput
        style={{ borderWidth: 1, padding: 10, marginBottom: 10 }}
        placeholder="Valor do saque"
        keyboardType="numeric"
        onChangeText={setValorSaque}
      />
     
      <Button title="Sacar Dinheiro" onPress={realizarSaque} color="#690B7D" />


      <Text style={{ marginTop: 20, fontWeight: 'bold' }}>{status}</Text>
      <Text style={{ color: '#690B7D', fontStyle: 'italic', marginTop: 5 }}>{fim}</Text>
    </View>
  );
}




