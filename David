    } catch (erro) {
      // Captura o texto enviado pelo throw
      setStatus(` Erro: ${erro}`);
    } finally {
      // Executa sempre ao terminar
      setFim('Validação de nota encerrada.');
    }
  };
 
  return (
    <View style={{ flex: 1, justifyContent: 'center', padding: 20 }}>
