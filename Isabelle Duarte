Conceitos utilizados.

import React, { useState } from "react";
import { View, TextInput, Button, Alert } from "react-native";

export default function App() {
  // Estado que armazena o saldo disponível
  const [saldo, setSaldo] = useState("");

  // Estado que armazena o valor do saque
  const [saque, setSaque] = useState("");

  // Função executada ao clicar no botão
  function realizarSaque() {
    try {
      // Converte os valores digitados para número
      const saldoAtual = Number(saldo);
      const valorSaque = Number(saque);

      // Verifica se o saque é maior que o saldo
      if (valorSaque > saldoAtual) {
        // Lança um erro personalizado
        throw new Error("Saldo insuficiente para realizar o saque.");
      }

      // Calcula o novo saldo após o saque
      const novoSaldo = saldoAtual - valorSaque;

      // Exibe mensagem de sucesso
      Alert.alert(
        "Sucesso",
        `Saque realizado!\nSaldo restante: R$ ${novoSaldo}`
      );

    } catch (erro) {
      // Captura qualquer erro lançado pelo throw
      Alert.alert("Erro", erro.message);

    } finally {
      // Sempre é executado, independentemente de erro ou sucesso
      console.log("Operação de saque finalizada.");
    }
  }

  return (
    <View style={{ padding: 20, marginTop: 50 }}>

      <TextInput
        placeholder="Digite o saldo"
        keyboardType="numeric"
        value={saldo}
        onChangeText={setSaldo}
        style={{
          borderWidth: 1,
          marginBottom: 10,
          padding: 10
        }}
      />

      <TextInput
        placeholder="Digite o valor do saque"
        keyboardType="numeric"
        value={saque}
        onChangeText={setSaque}
        style={{
          borderWidth: 1,
          marginBottom: 10,
          padding: 10
        }}
      />

      <Button
        title="Realizar Saque"
        onPress={realizarSaque}
      />

    </View>
  );
}

