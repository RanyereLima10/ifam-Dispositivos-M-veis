import React, { useState } from 'react';
import { StyleSheet, Text, TextInput, View, Button, SafeAreaView } from 'react-native';


export default function App() {
  // Variáveis de estado
  const [entradaIdade, setEntradaIdade] = useState('');
  const [resultado, setResultado] = useState('');
  const [mensagemFinally, setMensagemFinally] = useState('');


  const verificarEntrada = () => {
    // Limpa mensagens anteriores
    setResultado('');
    setMensagemFinally('');


    try {
      // Converte a entrada para número inteiro
      const idade = parseInt(entradaIdade, 10);


      // Condição IF e uso do THROW para lançar exceções
      if (isNaN(idade)) {
        throw new Error('Por favor, digite um número válido.');
      }
     
      if (idade < 0) {
        throw new Error('A idade não pode ser negativa.');
      }


      if (idade < 18) {
        throw new Error('Entrada proibida: Menor de 18 anos.');
      }


      // Se passar por todas as validações
      setResultado('Acesso autorizado! Divirta-se no evento.');


    } catch (error) {
      // CATCH captura o erro lançado pelo THROW ou pelo sistema
      setResultado(`Erro: ${error.message}`);


    } finally {
      // FINALLY sempre executa, independente de erro ou sucesso
      setMensagemFinally('Processo de verificação encerrado.');
    }
  };


  return (
    <SafeAreaView style={styles.container}>
      <View style={styles.card}>
        <Text style={styles.titulo}>Validação de Idade</Text>
        <Text style={styles.subtitulo}>Verifique a permissão para o evento</Text>


        <TextInput
          style={styles.input}
          placeholder="Digite sua idade"
          keyboardType="numeric"
          value={entradaIdade}
          onChangeText={setEntradaIdade}
        />


        <Button title="Verificar Idade" onPress={verificarEntrada} color="#6200ee" />


        {resultado ? <Text style={styles.textoResultado}>{resultado}</Text> : null}
        {mensagemFinally ? <Text style={styles.textoFinally}>{mensagemFinally}</Text> : null}
      </View>
    </SafeAreaView>
  );
}


