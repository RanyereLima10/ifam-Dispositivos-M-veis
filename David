export default function App() {
  const [notaInput, setNotaInput] = useState('');
  const [status, setStatus] = useState('');
  const [fim, setFim] = useState('');


  const validarNota = () => {
    try {
      const nota = parseFloat(notaInput);


      // Regras de validação utilizando Condição e Throw
      if (isNaN(nota)) {
        throw 'Por favor, digite um número válido! (acha que ta no Estados Unidos e!? 🤔)';
      }
      if (nota < 0) {
        throw 'Nota inválida! A nota não pode ser menor que 0.  (voce conseguiu tirar uma nota menor que 0!? 🐴)';
      }
      if (nota > 10) {
        throw 'Nota inválida! A nota não pode ser maior que 10. (Deve ser o orgulho da mamãe! 🥰)';
      }


      // Se passar por todas as regras
