import React, { useState, useEffect } from 'react';
import {
  StyleSheet,
  Text,
  View,
  TextInput,
  TouchableOpacity,
  SafeAreaView,
  ScrollView,
  Keyboard,
  ActivityIndicator,
  Alert,
  StatusBar,
} from 'react-native';
import AsyncStorage from '@react-native-async-storage/async-storage';

// =====================================================
// OPENROUTER
// =====================================================
const OPENROUTER_API_KEY = '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'; 
const MODEL = 'openai/gpt-4o-mini';

const STORAGE_KEY = '@ecomonitor_historico';

export default function App() {
  const [litrosDiarios, setLitrosDiarios] = useState('');
  const [carregando, setCarregando] = useState(false);
  const [resultadoIA, setResultadoIA] = useState(null);
  const [historico, setHistorico] = useState([]);

  useEffect(() => {
    carregarHistorico();
  }, []);

  const carregarHistorico = async () => {
    try {
      const dados = await AsyncStorage.getItem(STORAGE_KEY);
      if (dados) {
        setHistorico(JSON.parse(dados));
      }
    } catch (erro) {
      console.log('Erro ao carregar histórico:', erro);
    }
  };

  const salvarNoHistorico = async (analise) => {
    try {
      const novoItem = {
        id: Date.now().toString(),
        ...analise,
        criado_em: new Date().toISOString(),
      };

      const dados = await AsyncStorage.getItem(STORAGE_KEY);
      const lista = dados ? JSON.parse(dados) : [];
      const novaLista = [novoItem, ...lista];

      await AsyncStorage.setItem(STORAGE_KEY, JSON.stringify(novaLista));
      setHistorico(novaLista);
    } catch (erro) {
      console.log('Erro ao salvar:', erro);
    }
  };

  const deletarAnalise = async (id) => {
    try {
      const novaLista = historico.filter((item) => item.id !== id);
      await AsyncStorage.setItem(STORAGE_KEY, JSON.stringify(novaLista));
      setHistorico(novaLista);
    } catch (erro) {
      console.log('Erro ao deletar:', erro);
    }
  };

  const limparHistorico = async () => {
    try {
      await AsyncStorage.removeItem(STORAGE_KEY);
      setHistorico([]);
    } catch (erro) {
      console.log('Erro ao limpar:', erro);
    }
  };

  const converterResposta = (texto) => {
    if (!texto) throw new Error('A IA não retornou nenhum conteúdo.');

    let textoLimpo = texto
      .trim()
      .replace(/^```json\s*/i, '')
      .replace(/^```\s*/i, '')
      .replace(/\s*```$/i, '')
      .trim();

    try {
      return JSON.parse(textoLimpo);
    } catch {
      throw new Error('A IA retornou um formato inválido.');
    }
  };

  const analisarConsumoComIA = async () => {
    if (!litrosDiarios.trim()) {
      Alert.alert('Atenção', 'Digite o consumo diário de água.');
      return;
    }

    const litros = parseFloat(litrosDiarios.replace(',', '.'));

    if (isNaN(litros) || litros <= 0) {
      Alert.alert('Atenção', 'Digite um número válido maior que zero.');
      return;
    }

    if (
      !OPENROUTER_API_KEY ||
      OPENROUTER_API_KEY.includes('SUA_CHAVE') ||
      OPENROUTER_API_KEY.includes(' ')
    ) {
      Alert.alert(
        'API não configurada',
        'Coloque sua chave do OpenRouter na variável OPENROUTER_API_KEY.'
      );
      return;
    }

    Keyboard.dismiss();
    setCarregando(true);
    setResultadoIA(null);

    const prompt = `
Você é a IA do aplicativo EcoMonitor IA.
O usuário informou um consumo de ${litros} litros de água por dia.

Faça uma análise simples.
Retorne SOMENTE JSON válido nesta estrutura:

{
  "semanal": "1050 litros",
  "classificacao": "Consumo moderado",
  "cor": "#3F51B5",
  "descricao": "Explicação curta do que o consumo significa.",
  "dica": "Dica prática para economizar água."
}

Não coloque texto fora do JSON.
`;

    try {
      const resposta = await fetch(
        'https://openrouter.ai/api/v1/chat/completions',
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${OPENROUTER_API_KEY}`,
            'HTTP-Referer': 'https://snack.expo.dev',
            'X-Title': 'EcoMonitor IA',
          },
          body: JSON.stringify({
            model: MODEL,
            messages: [{ role: 'user', content: prompt }],
            response_format: { type: 'json_object' },
            max_tokens: 400,
            temperature: 0.3,
          }),
        }
      );

      const dados = await resposta.json();

      if (!resposta.ok) {
        throw new Error(
          dados?.error?.message || `Erro HTTP ${resposta.status}`
        );
      }

      const textoIA = dados?.choices?.[0]?.message?.content;
      if (!textoIA) {
        throw new Error('A IA não retornou resposta.');
      }

      const resultado = converterResposta(textoIA);

      const resultadoFinal = {
        litrosDiarios: litros,
        semanal: resultado.semanal || `${litros * 7} litros`,
        classificacao: resultado.classificacao || 'Consumo analisado',
        cor: resultado.cor || '#3F51B5',
        descricao:
          resultado.descricao ||
          'A IA analisou o consumo informado.',
        dica: resultado.dica || 'Evite desperdícios de água.',
      };

      setResultadoIA(resultadoFinal);
      await salvarNoHistorico(resultadoFinal);
    } catch (erro) {
      console.log('ERRO:', erro);
      Alert.alert(
        'Erro',
        erro?.message || 'Não foi possível conectar ao OpenRouter.'
      );
    } finally {
      setCarregando(false);
    }
  };

  const novaAnalise = () => {
    setResultadoIA(null);
    setLitrosDiarios('');
  };

  const confirmarLimpar = () => {
    Alert.alert('Limpar histórico', 'Apagar todas as análises?', [
      { text: 'Cancelar', style: 'cancel' },
      {
        text: 'Apagar',
        style: 'destructive',
        onPress: limparHistorico,
      },
    ]);
  };

  const confirmarDeletar = (id) => {
    Alert.alert('Excluir', 'Remover esta análise?', [
      { text: 'Cancelar', style: 'cancel' },
      {
        text: 'Excluir',
        style: 'destructive',
        onPress: () => deletarAnalise(id),
      },
    ]);
  };

  const formatarData = (iso) => {
    try {
      return new Date(iso).toLocaleString('pt-BR', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      });
    } catch {
      return '';
    }
  };

  return (
    <SafeAreaView style={styles.container}>
      <StatusBar barStyle="dark-content" backgroundColor="#F0F2F5" />

      <ScrollView
        contentContainerStyle={styles.scrollContent}
        keyboardShouldPersistTaps="handled"
      >
        <View style={styles.header}>
          <Text style={styles.title}>EcoMonitor IA</Text>
          <Text style={styles.subtitle}>Monitore seu consumo de água</Text>
        </View>

        <View style={styles.card}>
          <Text style={styles.label}>Consumo diário</Text>
          <Text style={styles.description}>
            Informe quantos litros de água são consumidos por dia.
          </Text>

          <TextInput
            style={styles.input}
            placeholder="Ex: 150"
            placeholderTextColor="#999"
            keyboardType="decimal-pad"
            value={litrosDiarios}
            onChangeText={setLitrosDiarios}
            editable={!carregando}
          />
          <Text style={styles.unit}>litros por dia</Text>

          <TouchableOpacity
            style={[styles.button, carregando && styles.buttonDisabled]}
            onPress={analisarConsumoComIA}
            disabled={carregando}
            activeOpacity={0.8}
          >
            {carregando ? (
              <>
                <ActivityIndicator color="#FFF" size="small" />
                <Text style={styles.buttonText}>Analisando...</Text>
              </>
            ) : (
              <Text style={styles.buttonText}>Analisar consumo</Text>
            )}
          </TouchableOpacity>
        </View>

        {resultadoIA && (
          <View
            style={[styles.resultCard, { borderLeftColor: resultadoIA.cor }]}
          >
            <Text style={styles.resultHeader}>RESULTADO DA IA</Text>
            <Text style={[styles.resultTitle, { color: resultadoIA.cor }]}>
              {resultadoIA.classificacao}
            </Text>

            <View style={styles.divider} />

            <Text style={styles.resultLabel}>Consumo semanal</Text>
            <Text style={styles.weeklyValue}>{resultadoIA.semanal}</Text>

            <Text style={styles.resultLabel}> O que aconteceu</Text>
            <Text style={styles.feedbackText}>{resultadoIA.descricao}</Text>

            <Text style={styles.resultLabel}> Dica</Text>
            <Text style={styles.feedbackText}>{resultadoIA.dica}</Text>

            <TouchableOpacity style={styles.newButton} onPress={novaAnalise}>
              <Text style={styles.newButtonText}>Nova análise</Text>
            </TouchableOpacity>
          </View>
        )}

        <View style={styles.historicoHeader}>
          <Text style={styles.historicoTitle}>Histórico</Text>
          {historico.length > 0 && (
            <TouchableOpacity onPress={confirmarLimpar}>
              <Text style={styles.limparTexto}>Limpar</Text>
            </TouchableOpacity>
          )}
        </View>

        {historico.length === 0 ? (
          <View style={styles.infoCard}>
            <Text style={styles.infoText}>
              Nenhuma análise salva ainda.
            </Text>
          </View>
        ) : (
          historico.map((item) => (
            <View
              key={item.id}
              style={[styles.historicoCard, { borderLeftColor: item.cor }]}
            >
              <View style={styles.historicoTop}>
                <Text style={[styles.historicoClass, { color: item.cor }]}>
                  {item.classificacao}
                </Text>
                <TouchableOpacity onPress={() => confirmarDeletar(item.id)}>
                  <Text style={styles.deletarTexto}>Excluir</Text>
                </TouchableOpacity>
              </View>

              <Text style={styles.historicoLitros}>
                {item.litrosDiarios} L/dia → {item.semanal}
              </Text>

              {item.descricao ? (
                <Text style={styles.historicoDesc} numberOfLines={2}>
                  {item.descricao}
                </Text>
              ) : null}

              <Text style={styles.historicoData}>
                {formatarData(item.criado_em)}
              </Text>
            </View>
          ))
        )}

        <View style={styles.infoCard}>
          <Text style={styles.infoTitle}> EcoMonitor IA</Text>
          <Text style={styles.infoText}>
            Histórico salvo no celular com AsyncStorage (funciona no Snack).
          </Text>
        </View>
      </ScrollView>
    </SafeAreaView>
  );
}

